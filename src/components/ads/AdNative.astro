---
// Adsterra native banner. Production builds only; at most once per page.
import { ADSTERRA_NATIVE } from '../../lib/ads';
---

{import.meta.env.PROD && (
  <div class="ad-slot ad-slot--native" role="complementary" aria-label="Advertisement">
    <span class="ad-label">Sponsored</span>
    <script is:inline async="async" data-cfasync="false" src={ADSTERRA_NATIVE.src}></script>
    <div id={ADSTERRA_NATIVE.containerId}></div>
  </div>
)}
