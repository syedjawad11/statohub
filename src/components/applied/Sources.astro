---
interface SourceItem {
  text: string;
  href: string;
  org?: string;
}

interface Props {
  items: SourceItem[];
  heading?: string;
}

const {
  items,
  heading = 'Sources',
} = Astro.props;

if (items.length === 0) {
  throw new Error('Sources: "items" must be a non-empty array.');
}
---

<section class="sources">
  <h3>{heading}</h3>
  <ol>
    {
      items.map((item) => (
        <li>
          <a href={item.href} rel="noopener">{item.text}</a>
          {item.org && <span class="sources-org">{item.org}</span>}
        </li>
      ))
    }
  </ol>
</section>

<style>
  .sources {
    padding: 1.25rem;
    border: 1px solid var(--line-2);
    border-radius: var(--r);
    background: var(--card);
    box-shadow: var(--shadow);
    color: var(--ink);
  }

  .sources h3 {
    margin: 0 0 0.9rem;
    color: var(--ink);
    font-family: var(--serif);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .sources ol {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding-left: 1.35rem;
    color: var(--ink-2);
  }

  .sources li::marker {
    color: var(--clay);
    font-family: var(--mono);
    font-size: 0.78rem;
    font-weight: 600;
  }

  .sources a {
    color: var(--pine);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--pine);
    text-underline-offset: 0.16em;
  }

  .sources-org {
    display: block;
    margin-top: 0.12rem;
    color: var(--ink-3);
    font-size: 0.88rem;
  }
</style>
