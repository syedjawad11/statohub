---
import SvgFrame from './_SvgFrame.astro';

interface Branch {
  label: string;
  children?: string[];
}

interface Props {
  title: string;
  desc: string;
  root: string;
  branches: Branch[];
}

const {
  title,
  desc,
  root,
  branches,
} = Astro.props;

if (branches.length === 0) {
  throw new Error('TaxonomyTree requires at least one branch.');
}

const wrapText = (text: string, maxCharacters: number): string[] => {
  const words = text.trim().split(/\s+/).filter(Boolean);
  if (words.length === 0) return [''];

  const lines: string[] = [];
  let line = '';

  for (const word of words) {
    if (word.length > maxCharacters) {
      if (line) lines.push(line);
      for (let offset = 0; offset < word.length; offset += maxCharacters) {
        lines.push(word.slice(offset, offset + maxCharacters));
      }
      line = '';
      continue;
    }

    const candidate = line ? `${line} ${word}` : word;
    if (candidate.length <= maxCharacters) {
      line = candidate;
    } else {
      lines.push(line);
      line = word;
    }
  }

  if (line) lines.push(line);
  return lines;
};

// Card-grid layout: the diagram wraps branches into rows of cards instead of
// one wide row, so the SVG's natural width stays close to the article's
// content column and never has to be scaled down hard enough to shrink the
// text past legibility. See docs/status/sessions for the readability fix.
const padding = 32;
const cardWidth = 216;
const colGap = 20;
const rowGap = 30;
const dropGap = 20;
const cardPaddingX = 16;
const cardPaddingY = 16;
const titleLineHeight = 19;
const titleBottomGap = 10;
const chipLineHeight = 16;
const chipPaddingY = 12;
const chipGap = 6;
const rootWidth = 240;
const rootPaddingY = 16;
const rootLineHeight = 19;

const cardInnerWidth = cardWidth - cardPaddingX * 2;
const rootInnerWidth = rootWidth - 32;

const rootLines = wrapText(root, Math.max(6, Math.floor(rootInnerWidth / 7.6)));
const rootHeight = Math.max(56, rootPaddingY * 2 + rootLines.length * rootLineHeight);
const rootY = padding;

const columns = branches.length <= 3 ? branches.length : branches.length === 4 ? 2 : 3;

const preparedBranches = branches.map((branch) => {
  const titleLines = wrapText(branch.label, Math.max(6, Math.floor(cardInnerWidth / 7.2)));
  const children = (branch.children ?? []).map((label) => {
    const lines = wrapText(label, Math.max(6, Math.floor(cardInnerWidth / 6.3)));
    return { label, lines, chipHeight: lines.length * chipLineHeight + chipPaddingY };
  });

  const contentHeight =
    titleLines.length * titleLineHeight +
    titleBottomGap +
    children.reduce((sum, child) => sum + child.chipHeight, 0) +
    Math.max(0, children.length - 1) * chipGap;

  return { ...branch, titleLines, children, contentHeight };
});

const cardContentHeight = Math.max(...preparedBranches.map((b) => b.contentHeight));
const cardHeight = cardContentHeight + cardPaddingY * 2;

const fullRowWidth = columns * cardWidth + (columns - 1) * colGap;
const canvasWidth = Math.max(rootWidth + padding * 2, fullRowWidth + padding * 2);
const resolvedRootX = (canvasWidth - rootWidth) / 2;

const rowsOfBranches: (typeof preparedBranches)[] = [];
for (let i = 0; i < preparedBranches.length; i += columns) {
  rowsOfBranches.push(preparedBranches.slice(i, i + columns));
}

let cursorY = rootY + rootHeight + rowGap;
const laidOutRows = rowsOfBranches.map((rowBranches) => {
  const busY = cursorY;
  const cardY = busY + dropGap;
  const rowWidth = rowBranches.length * cardWidth + (rowBranches.length - 1) * colGap;
  const startX = (canvasWidth - rowWidth) / 2;

  const cards = rowBranches.map((branch, index) => {
    const cardX = startX + index * (cardWidth + colGap);
    let chipY = cardY + cardPaddingY + branch.titleLines.length * titleLineHeight + titleBottomGap;
    const chips = branch.children.map((child) => {
      const chip = { ...child, x: cardX, y: chipY, width: cardWidth };
      chipY += child.chipHeight + chipGap;
      return chip;
    });
    return { ...branch, cardX, cardY, chips };
  });

  const rowBottom = cardY + cardHeight;
  cursorY = rowBottom + rowGap;

  return { busY, cardY, rowBottom, cards };
});

const canvasHeight = laidOutRows[laidOutRows.length - 1].rowBottom + padding;
const trunkBottomY = laidOutRows[laidOutRows.length - 1].busY;
const centerX = canvasWidth / 2;
---

<SvgFrame
  title={title}
  desc={desc}
  viewBox={`0 0 ${canvasWidth} ${canvasHeight}`}
  maxWidth={`${canvasWidth}px`}
>
  <g class="taxonomy-connectors" aria-hidden="true">
    <path
      class="taxonomy-line"
      d={`M ${centerX} ${rootY + rootHeight} V ${trunkBottomY}`}
    />
    {
      laidOutRows.map((row) => {
        const cardCenters = row.cards.map((c) => c.cardX + cardWidth / 2);
        const left = Math.min(...cardCenters);
        const right = Math.max(...cardCenters);
        return (
          <>
            {cardCenters.length > 1 && (
              <path class="taxonomy-line" d={`M ${left} ${row.busY} H ${right}`} />
            )}
            {row.cards.map((card) => (
              <path
                class="taxonomy-line"
                d={`M ${card.cardX + cardWidth / 2} ${row.busY} V ${row.cardY}`}
              />
            ))}
          </>
        );
      })
    }
  </g>

  <g class="taxonomy-root">
    <rect class="taxonomy-root-box" x={resolvedRootX} y={rootY} width={rootWidth} height={rootHeight} rx="12" />
    <text class="taxonomy-root-text" text-anchor="middle">
      {rootLines.map((line, lineIndex) => {
        const startY = rootY + rootHeight / 2 - ((rootLines.length - 1) * rootLineHeight) / 2 + 5;
        return <tspan x={resolvedRootX + rootWidth / 2} y={startY + lineIndex * rootLineHeight}>{line}</tspan>;
      })}
    </text>
  </g>

  {
    laidOutRows.map((row) =>
      row.cards.map((card) => (
        <g class="taxonomy-card">
          <rect
            class="taxonomy-card-box"
            x={card.cardX}
            y={card.cardY}
            width={cardWidth}
            height={cardHeight}
            rx="12"
          />
          <text class="taxonomy-card-title" text-anchor="middle">
            {card.titleLines.map((line, lineIndex) => (
              <tspan
                x={card.cardX + cardWidth / 2}
                y={card.cardY + cardPaddingY + (lineIndex + 1) * titleLineHeight - 5}
              >
                {line}
              </tspan>
            ))}
          </text>
          <line
            class="taxonomy-card-divider"
            x1={card.cardX + cardPaddingX}
            x2={card.cardX + cardWidth - cardPaddingX}
            y1={card.cardY + cardPaddingY + card.titleLines.length * titleLineHeight + titleBottomGap / 2}
            y2={card.cardY + cardPaddingY + card.titleLines.length * titleLineHeight + titleBottomGap / 2}
          />
          {card.chips.map((chip) => (
            <g class="taxonomy-chip">
              <rect
                class="taxonomy-chip-box"
                x={chip.x + cardPaddingX}
                y={chip.y}
                width={cardWidth - cardPaddingX * 2}
                height={chip.chipHeight}
                rx="8"
              />
              <text class="taxonomy-chip-text" text-anchor="middle">
                {chip.lines.map((line, lineIndex) => (
                  <tspan
                    x={chip.x + cardWidth / 2}
                    y={chip.y + chipPaddingY / 2 + (lineIndex + 1) * chipLineHeight - 4}
                  >
                    {line}
                  </tspan>
                ))}
              </text>
            </g>
          ))}
        </g>
      )),
    )
  }
</SvgFrame>

<style>
  .taxonomy-line {
    fill: none;
    stroke: var(--line-2);
    stroke-width: 1.5;
  }

  .taxonomy-root-box {
    fill: var(--pine);
    stroke: var(--pine);
    stroke-width: 1.5;
  }

  .taxonomy-root-text {
    fill: var(--card);
    font-family: var(--sans);
    font-size: 16px;
    font-weight: 700;
  }

  .taxonomy-card-box {
    fill: var(--card);
    stroke: var(--line-2);
    stroke-width: 1.5;
  }

  .taxonomy-card-title {
    fill: var(--pine);
    font-family: var(--sans);
    font-size: 15px;
    font-weight: 700;
  }

  .taxonomy-card-divider {
    stroke: var(--line-2);
    stroke-width: 1;
  }

  .taxonomy-chip-box {
    fill: var(--paper-2);
    stroke: var(--line-2);
    stroke-width: 1;
  }

  .taxonomy-chip-text {
    fill: var(--ink-2);
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 500;
  }
</style>
