---
import SvgFrame from './_SvgFrame.astro';

interface Step {
  label: string;
  detail?: string;
}

interface Props {
  title: string;
  desc: string;
  steps: Step[];
  direction?: 'horizontal' | 'vertical';
}

const {
  title,
  desc,
  steps,
  direction = 'horizontal',
} = Astro.props;

if (steps.length === 0) {
  throw new Error('ProcessFlow requires at least one step.');
}

const wrapText = (text: string, maxCharacters: number): string[] => {
  const words = text.trim().split(/\s+/).filter(Boolean);
  if (words.length === 0) return [''];

  const lines: string[] = [];
  let line = '';

  for (const word of words) {
    if (word.length > maxCharacters) {
      if (line) lines.push(line);
      for (let offset = 0; offset < word.length; offset += maxCharacters) {
        lines.push(word.slice(offset, offset + maxCharacters));
      }
      line = '';
      continue;
    }

    const candidate = line ? `${line} ${word}` : word;
    if (candidate.length <= maxCharacters) {
      line = candidate;
    } else {
      lines.push(line);
      line = word;
    }
  }

  if (line) lines.push(line);
  return lines;
};

const padding = 28;
const gap = direction === 'horizontal' ? 48 : 38;
const boxWidth = direction === 'horizontal' ? 184 : 360;
const labelCharacters = direction === 'horizontal' ? 18 : 40;
const detailCharacters = direction === 'horizontal' ? 24 : 48;
const rowGap = 56;

const preparedSteps = steps.map((step) => {
  const labelLines = wrapText(step.label, labelCharacters);
  const detailLines = step.detail ? wrapText(step.detail, detailCharacters) : [];
  const labelBottom = 29 + (labelLines.length - 1) * 16;
  const detailStart = labelBottom + 22;
  const contentBottom = detailLines.length > 0
    ? detailStart + (detailLines.length - 1) * 14
    : labelBottom;

  return {
    ...step,
    labelLines,
    detailLines,
    detailStart,
    height: Math.max(78, contentBottom + 21),
  };
});

const horizontalHeight = Math.max(...preparedSteps.map((step) => step.height));

// Horizontal flows wrap into rows of up to 3 steps instead of one wide row,
// so the canvas stays close to the article column and never has to be
// scaled down hard enough to shrink the text past legibility — the same
// card-grid rule used in TaxonomyTree.astro.
const columns = steps.length <= 3 ? steps.length : steps.length === 4 ? 2 : 3;

let canvasWidth: number;
let canvasHeight: number;
let laidOutSteps: (typeof preparedSteps[number] & { x: number; y: number })[];

if (direction === 'horizontal') {
  const rowsOfSteps: (typeof preparedSteps)[] = [];
  for (let i = 0; i < preparedSteps.length; i += columns) {
    rowsOfSteps.push(preparedSteps.slice(i, i + columns));
  }

  const fullRowWidth = columns * boxWidth + (columns - 1) * gap;
  canvasWidth = padding * 2 + fullRowWidth;

  laidOutSteps = rowsOfSteps.flatMap((rowSteps, rowIndex) => {
    const rowWidth = rowSteps.length * boxWidth + (rowSteps.length - 1) * gap;
    const startX = (canvasWidth - rowWidth) / 2;
    const y = padding + rowIndex * (horizontalHeight + rowGap);
    return rowSteps.map((step, colIndex) => ({
      ...step,
      x: startX + colIndex * (boxWidth + gap),
      y,
      height: horizontalHeight,
    }));
  });

  canvasHeight = padding * 2 + rowsOfSteps.length * horizontalHeight + (rowsOfSteps.length - 1) * rowGap;
} else {
  let verticalOffset = padding;
  laidOutSteps = preparedSteps.map((step) => {
    const laidOut = { ...step, x: padding, y: verticalOffset };
    verticalOffset += step.height + gap;
    return laidOut;
  });
  canvasWidth = padding * 2 + boxWidth;
  canvasHeight = verticalOffset - gap + padding;
}

const connectors = laidOutSteps.slice(0, -1).map((step, index) => {
  const next = laidOutSteps[index + 1];

  if (direction === 'vertical') {
    const x = step.x + boxWidth / 2;
    return {
      line: `M ${x} ${step.y + step.height} V ${next.y - 8}`,
      arrow: `M ${x} ${next.y} l -6 -9 h 12 z`,
    };
  }

  if (step.y === next.y) {
    const y = step.y + step.height / 2;
    return {
      line: `M ${step.x + boxWidth} ${y} H ${next.x - 8}`,
      arrow: `M ${next.x} ${y} l -9 -6 v 12 z`,
    };
  }

  const startX = step.x + boxWidth / 2;
  const endX = next.x + boxWidth / 2;
  const startY = step.y + step.height;
  const midY = startY + rowGap / 2;
  return {
    line: `M ${startX} ${startY} V ${midY} H ${endX} V ${next.y - 8}`,
    arrow: `M ${endX} ${next.y} l -6 -9 h 12 z`,
  };
});
---

<SvgFrame
  title={title}
  desc={desc}
  viewBox={`0 0 ${canvasWidth} ${canvasHeight}`}
  maxWidth={`${canvasWidth}px`}
>
  <g class="process-connectors" aria-hidden="true">
    {
      connectors.map((connector) => (
        <>
          <path class="process-line" d={connector.line} />
          <path class="process-arrow" d={connector.arrow} />
        </>
      ))
    }
  </g>

  {
    laidOutSteps.map((step, index) => {
      const labelX = step.x + 47;
      const labelY = step.y + 29;
      const detailX = step.x + 18;

      return (
        <g class="process-step">
          <rect
            class="process-box"
            x={step.x}
            y={step.y}
            width={boxWidth}
            height={step.height}
            rx="12"
          />
          <circle class="process-number" cx={step.x + 24} cy={step.y + 25} r="14" />
          <text class="process-number-text" x={step.x + 24} y={step.y + 29} text-anchor="middle">
            {index + 1}
          </text>
          <text class="process-label">
            {step.labelLines.map((line, lineIndex) => (
              <tspan x={labelX} y={labelY + lineIndex * 16}>{line}</tspan>
            ))}
          </text>
          {step.detailLines.length > 0 && (
            <text class="process-detail">
              {step.detailLines.map((line, lineIndex) => (
                <tspan x={detailX} y={step.y + step.detailStart + lineIndex * 14}>{line}</tspan>
              ))}
            </text>
          )}
        </g>
      );
    })
  }
</SvgFrame>

<style>
  .process-box {
    fill: var(--paper-2);
    stroke: var(--line-2);
    stroke-width: 1.5;
  }

  .process-number {
    fill: var(--pine);
  }

  .process-number-text {
    fill: var(--card);
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 600;
  }

  .process-label {
    fill: var(--ink);
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 600;
  }

  .process-detail {
    fill: var(--ink-2);
    font-family: var(--sans);
    font-size: 11px;
  }

  .process-line {
    fill: none;
    stroke: var(--pine);
    stroke-width: 2;
  }

  .process-arrow {
    fill: var(--pine);
  }
</style>
