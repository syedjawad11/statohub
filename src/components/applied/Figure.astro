---
interface Props {
  caption: string;
  number?: number;
  id?: string;
}

const {
  caption,
  number,
  id,
} = Astro.props;
---

<figure class="applied-figure" id={id}>
  <div class="applied-figure-content">
    <slot />
  </div>
  <figcaption>
    {number !== undefined && <strong>Figure {number}. </strong>}{caption}
  </figcaption>
</figure>

<style>
  .applied-figure {
    margin: 0;
    color: var(--ink);
  }

  .applied-figure-content {
    overflow: hidden;
    border: 1px solid var(--line-2);
    border-radius: var(--r);
    background: var(--card);
    box-shadow: var(--shadow);
  }

  figcaption {
    margin-top: 0.7rem;
    color: var(--ink-2);
    font-size: 0.9rem;
    line-height: 1.45;
  }

  figcaption strong {
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.8rem;
    font-weight: 600;
  }
</style>
