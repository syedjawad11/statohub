---
interface Props {
  variant?: 'table' | 'bullets';
  heading?: string;
  rows?: { point: string; details: string }[];
  bullets?: string[];
}

const {
  variant = 'table',
  heading = 'Key takeaways',
  rows,
  bullets,
} = Astro.props;

if (variant === 'table' && (!rows || rows.length === 0)) {
  throw new Error('KeyTakeaways: "rows" must be a non-empty array when variant="table".');
}

if (variant === 'bullets' && (!bullets || bullets.length === 0)) {
  throw new Error('KeyTakeaways: "bullets" must be a non-empty array when variant="bullets".');
}
---

<section class:list={['key-takeaways', `key-takeaways--${variant}`]}>
  <h2>{heading}</h2>

  {
    variant === 'table' ? (
      <div
        class="key-takeaways-table-wrap"
        role="region"
        aria-label={`${heading} table`}
        tabindex="0"
      >
        <table>
          <thead>
            <tr>
              <th scope="col">Point</th>
              <th scope="col">Details</th>
            </tr>
          </thead>
          <tbody>
            {rows?.map((row) => (
              <tr>
                <th scope="row">{row.point}</th>
                <td>{row.details}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <ul>
        {bullets?.map((bullet) => <li>{bullet}</li>)}
      </ul>
    )
  }
</section>

<style>
  .key-takeaways {
    overflow: hidden;
    border: 1px solid var(--line-2);
    border-radius: var(--r);
    background: var(--card);
    box-shadow: var(--shadow);
    color: var(--ink);
  }

  .key-takeaways h2 {
    margin: 0;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--line);
    background: var(--pine-soft);
    color: var(--pine);
    font-family: var(--serif);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .key-takeaways-table-wrap {
    max-width: 100%;
    overflow-x: auto;
  }

  table {
    width: 100%;
    min-width: 34rem;
    border-collapse: collapse;
  }

  th,
  td {
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  thead th {
    background: var(--paper-2);
    color: var(--ink-2);
    font-family: var(--mono);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  tbody th {
    width: 32%;
    color: var(--ink);
    font-weight: 600;
  }

  tbody td {
    color: var(--ink-2);
  }

  tbody tr:last-child > * {
    border-bottom: 0;
  }

  .key-takeaways ul {
    display: grid;
    gap: 0.8rem;
    margin: 0;
    padding: 1.25rem 1.5rem 1.25rem 2.7rem;
    color: var(--ink-2);
  }

  .key-takeaways li::marker {
    color: var(--pine);
  }
</style>
