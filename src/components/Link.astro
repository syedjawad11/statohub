---
import { url, type RouteRef } from '../lib/links';

interface Props {
  to: RouteRef;
  /** In-page fragment on the target route, without the leading '#'. */
  hash?: string;
  class?: string;
  id?: string;
  title?: string;
  target?: string;
  rel?: string;
  download?: boolean | string;
  'aria-current'?: boolean | 'page' | 'step' | 'location' | 'date' | 'time';
  'aria-label'?: string;
  [attribute: `aria-${string}`]: string | number | boolean | undefined;
  [attribute: `data-${string}`]: string | number | boolean | undefined;
}

// Internal page routes only. Use a plain <a> for external, same-page anchor, or asset links.
const { to, hash, ...rest } = Astro.props;
const href = hash ? `${url(to)}#${hash}` : url(to);
---

<a href={href} {...rest}><slot /></a>
