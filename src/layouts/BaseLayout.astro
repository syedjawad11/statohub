---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Link from '../components/Link.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Canonical from '../components/seo/Canonical.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import Meta from '../components/seo/Meta.astro';
import { routes, url, type CategoryId, type RouteRef } from '../lib/links';
import { breadcrumbList, EDITORIAL_TEAM, type BreadcrumbItem } from '../lib/schema';
import { ADSTERRA_INVOKE_BASE } from '../lib/ads';

type CategoryEntry = CollectionEntry<'categories'>;

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: RouteRef;
  ogType?: 'website' | 'article';
  ogImage?: string;
  breadcrumbs?: BreadcrumbItem[];
  showBreadcrumbs?: boolean;
  jsonLd?: object[];
  noindex?: boolean;
  /** Adsterra banner ads. Off for trust pages; always off on noindex pages. */
  ads?: boolean;
}

const {
  title = 'Statohub',
  description = 'Statistics education and calculator tools.',
  canonicalPath,
  ogType = 'website',
  ogImage = '/og-default.png',
  breadcrumbs,
  showBreadcrumbs = true,
  jsonLd = [],
  noindex = false,
  ads = true,
} = Astro.props;

const adsterraEnabled = import.meta.env.PROD && !noindex && ads;

const site = Astro.site ?? Astro.url;
const canonical = new URL(canonicalPath ? url(canonicalPath) : Astro.url.pathname, site);
canonical.search = '';
canonical.hash = '';

if (!canonical.pathname.endsWith('/')) {
  canonical.pathname = `${canonical.pathname}/`;
}

const schemas = breadcrumbs
  ? [breadcrumbList(breadcrumbs, site), ...jsonLd]
  : jsonLd;

const navLinks = [
  { label: 'Learn', route: routes.learnLanding() },
  { label: 'Applied', route: routes.appliedLanding() },
  { label: 'Calculators', route: routes.calculatorsHub() },
];

const footerLearnCategories = (await getCollection('categories'))
  .filter((entry: CategoryEntry) => entry.data.section === 'learn')
  .sort((a: CategoryEntry, b: CategoryEntry) => a.data.order - b.data.order);
const footerAppliedCategories = (await getCollection('categories'))
  .filter((entry: CategoryEntry) => entry.data.section === 'applied')
  .sort((a: CategoryEntry, b: CategoryEntry) => a.data.order - b.data.order);
const categoryId = (entry: CategoryEntry) => entry.id.replace(/\.[^.]+$/, '') as CategoryId;

const footerCalculators = [
  { label: 'Standard deviation', route: routes.calculator('standard-deviation') },
  { label: 'Mean', route: routes.calculator('mean') },
  { label: 'Range', route: routes.calculator('range') },
  { label: 'All tools', route: routes.calculatorsHub() },
];

// Public AdSense publisher ID; keep in sync with public/ads.txt.
const ADSENSE_PUBLISHER_ID = 'ca-pub-4667906964697238';
// Bare form (no "ca-" prefix), used by the Funding Choices messaging tag.
const FUNDING_CHOICES_PUBLISHER_ID = 'pub-4667906964697238';
// Google Analytics 4 measurement ID; the googletagmanager/google-analytics
// hosts it needs are allowlisted in public/_headers CSP.
const GA_MEASUREMENT_ID = 'G-PVHDLYC7T4';
// Ahrefs Web Analytics site key; analytics.ahrefs.com is allowlisted in
// public/_headers CSP (script-src + connect-src).
const AHREFS_ANALYTICS_KEY = 'Ua/EUJ9dT7YQDw2baSnUJQ';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Meta
      title={title}
      description={description}
      canonicalUrl={canonical.href}
      ogType={ogType}
      ogImage={ogImage}
    />
    <Canonical canonicalPath={canonicalPath ? url(canonicalPath) : undefined} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    {schemas.map((schema) => <JsonLd schema={schema} />)}
    {import.meta.env.PROD && !noindex && (
      <>
        {/* Google Funding Choices: certified CMP for EEA/UK consent, must load before the ad loader. */}
        <script
          is:inline
          async
          src={`https://fundingchoicesmessages.google.com/i/${FUNDING_CHOICES_PUBLISHER_ID}?ers=1`}
        ></script>
        <script is:inline>
          (function () {
            function signalGooglefcPresent() {
              if (!window.frames['googlefcPresent']) {
                if (document.body) {
                  const iframe = document.createElement('iframe');
                  iframe.style = 'width: 0; height: 0; border: none; z-index: -1000; left: -1000px; top: -1000px;';
                  iframe.style.display = 'none';
                  iframe.name = 'googlefcPresent';
                  document.body.appendChild(iframe);
                } else {
                  setTimeout(signalGooglefcPresent, 0);
                }
              }
            }
            signalGooglefcPresent();
          })();
        </script>
        <script
          is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_PUBLISHER_ID}`}
          crossorigin='anonymous'
        ></script>
      </>
    )}
    {import.meta.env.PROD && (
      <>
        {/* Google Analytics 4 (gtag.js): loads on production builds only. */}
        <script
          is:inline
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}
        ></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', 'G-PVHDLYC7T4');
        </script>
        {/* Ahrefs Web Analytics: loads on production builds only. */}
        <script
          is:inline
          async
          src="https://analytics.ahrefs.com/analytics.js"
          data-key={AHREFS_ANALYTICS_KEY}
        ></script>
      </>
    )}
    <script is:inline>
      (() => {
        // Light is the default; dark only when the visitor has chosen it via the toggle.
        const useDark = localStorage.getItem('theme') === 'dark';
        document.documentElement.classList.toggle('dark', useDark);
      })();
    </script>
  </head>
  <body>
    <header class="topbar">
      <div class="site-wrap topbar-inner">
        <Link to={routes.home()} class="brand" aria-label="Statohub home">
          <span class="brand-dot" aria-hidden="true"></span>
          Statohub
        </Link>
        <nav class="nav-links" aria-label="Primary navigation">
          {navLinks.map((item) => <Link to={item.route} class="nav-link">{item.label}</Link>)}
        </nav>
        <span class="nav-spacer"></span>
        <button
          id="theme-toggle"
          type="button"
          class="toggle icon-btn"
          aria-label="Toggle dark mode"
          aria-pressed="false"
          title="Toggle theme"
        >
          <svg class="sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4 12H2M22 12h-2M5 5l1.5 1.5M17.5 17.5L19 19M5 19l1.5-1.5M17.5 6.5L19 5"></path>
          </svg>
          <svg class="moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a6.5 6.5 0 0 0 9.8 9.8Z"></path>
          </svg>
        </button>
        <Link to={routes.calculatorsHub()} class="btn btn-pine nav-cta">Browse calculators</Link>
        <button
          id="menu-toggle"
          type="button"
          class="btn icon-btn menu-toggle"
          aria-label="Menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M3 6h18M3 12h18M3 18h18"></path>
          </svg>
        </button>
      </div>
      <div id="mobile-menu" class="mobile-panel site-wrap" data-open="false">
        <nav aria-label="Mobile navigation">
          {navLinks.map((item) => <Link to={item.route}>{item.label}</Link>)}
          <Link to={routes.calculatorsHub()}>Browse calculators</Link>
        </nav>
      </div>
    </header>
    <main class="site-main">
      <div class="site-wrap">
        {showBreadcrumbs && breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
        <slot />
      </div>
    </main>
    <footer class="foot">
      <div class="site-wrap">
        <div class="foot-grid foot-inner">
          <div class="foot-brand">
            <Link to={routes.home()} class="brand">
              <span class="brand-dot" aria-hidden="true"></span>
              Statohub
            </Link>
            <p>Statistics education and calculator tools for clear, practical learning.</p>
            <p class="foot-contact">
              Contact us: <!--email_off--><a href={`mailto:${EDITORIAL_TEAM.email}`}>{EDITORIAL_TEAM.email}</a><!--/email_off-->
            </p>
          </div>
          <div>
            <h5>Learn</h5>
            {footerLearnCategories.map((entry: CategoryEntry) => (
              <Link to={routes.categoryHub(categoryId(entry))}>{entry.data.title}</Link>
            ))}
            <Link to={routes.learnLanding()}>All Learn topics</Link>
          </div>
          <div>
            <h5>Applied</h5>
            {footerAppliedCategories.map((entry: CategoryEntry) => (
              <Link to={routes.categoryHub(categoryId(entry))}>{entry.data.title}</Link>
            ))}
            <Link to={routes.appliedLanding()}>All Applied topics</Link>
          </div>
          <div>
            <h5>Calculators</h5>
            {footerCalculators.map((item) => <Link to={item.route}>{item.label}</Link>)}
          </div>
          <div>
            <h5>Site</h5>
            <Link to={routes.about()}>About</Link>
            <Link to={routes.editorialPolicy()}>Editorial policy</Link>
            <Link to={routes.contact()}>Contact</Link>
            <Link to={routes.privacyCookiePolicy()}>Privacy & Cookies</Link>
            <Link to={routes.privacyCookiePolicy()} hash="terms">Terms</Link>
            <a href="/sitemap-index.xml">Sitemap</a>
          </div>
        </div>
        <div class="foot-bottom">
          <span>&copy; 2026 Statohub</span>
          <span class="font-mono">Statistics, explained plainly</span>
        </div>
      </div>
    </footer>
    {adsterraEnabled && (
      <>
        {/* Adsterra banner loader: each slot gets its own srcdoc iframe so the global atOptions never collide. */}
        <script is:inline define:vars={{ invokeBase: ADSTERRA_INVOKE_BASE }}>
          (() => {
            const RAIL_TOP = 90;
            const pick = (slot, sizes) => {
              const width = slot.querySelector('.ad-frame')?.clientWidth ?? 0;
              const rail = slot.hasAttribute('data-ad-fit-rail') ? slot.closest('.article-rail-right') : null;
              const railUsed = rail ? rail.offsetHeight - slot.offsetHeight : 0;
              return sizes.find((size) =>
                size.width <= width && (!rail || RAIL_TOP + railUsed + size.height + 60 <= window.innerHeight));
            };
            const fill = (slot) => {
              let sizes = [];
              try { sizes = JSON.parse(slot.dataset.adSizes || '[]'); } catch { return; }
              const size = pick(slot, sizes);
              if (!size) { slot.classList.add('ad-slot--empty'); return; }
              const frame = document.createElement('iframe');
              frame.width = String(size.width);
              frame.height = String(size.height);
              frame.title = 'Advertisement';
              frame.setAttribute('scrolling', 'no');
              // Match the srcdoc's light scheme so dark mode doesn't paint an opaque white box.
              frame.style.colorScheme = 'light';
              frame.srcdoc = '<!doctype html><html><head><style>html,body{margin:0;padding:0;overflow:hidden;background:transparent}</style></head><body>'
                + '<script>atOptions={key:"' + size.key + '",format:"iframe",height:' + size.height + ',width:' + size.width + ',params:{}};<\/script>'
                + '<script src="' + invokeBase + '/' + size.key + '/invoke.js"><\/script></body></html>';
              slot.querySelector('.ad-frame').appendChild(frame);
              slot.classList.add('ad-slot--filled');
            };
            const slots = document.querySelectorAll('.ad-slot[data-ad-sizes]');
            if (!('IntersectionObserver' in window)) { slots.forEach(fill); return; }
            const io = new IntersectionObserver((entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                io.unobserve(entry.target);
                fill(entry.target);
              });
            }, { rootMargin: '300px 0px' });
            slots.forEach((slot) => io.observe(slot));
          })();
        </script>
      </>
    )}
    <script is:inline>
      (() => {
        const themeButton = document.getElementById('theme-toggle');
        const menuButton = document.getElementById('menu-toggle');
        const menu = document.getElementById('mobile-menu');

        const syncPressed = () => {
          themeButton?.setAttribute(
            'aria-pressed',
            String(document.documentElement.classList.contains('dark')),
          );
        };

        themeButton?.addEventListener('click', () => {
          const nextIsDark = !document.documentElement.classList.contains('dark');
          document.documentElement.classList.toggle('dark', nextIsDark);
          localStorage.setItem('theme', nextIsDark ? 'dark' : 'light');
          syncPressed();
        });

        menuButton?.addEventListener('click', () => {
          const nextOpen = menu?.dataset.open !== 'true';
          if (menu) menu.dataset.open = String(nextOpen);
          menuButton.setAttribute('aria-expanded', String(nextOpen));
        });

        syncPressed();
      })();
    </script>
  </body>
</html>
