---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Link from '../../../components/Link.astro';
import StatCalc from '../../../components/StatCalc.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { routes } from '../../../lib/links';
import { getRelatedCalculators } from '../../../lib/related-calculators';
import { organizationSchema, webPageSchema, webSiteSchema, EDITORIAL_TEAM, type BreadcrumbItem } from '../../../lib/schema';
import { guideDates } from '../../../lib/dates';

type CalculatorEntry = CollectionEntry<'calculators'>;
type CalculatorData = CalculatorEntry['data'];
type CalculatorId = CalculatorEntry['id'];

export async function getStaticPaths() {
  const calculators = await getCollection('calculators');

  return calculators
    .filter((entry: CalculatorEntry) => entry.data.standalone !== false)
    .map((entry: CalculatorEntry) => ({
      params: { slug: entry.id },
      props: { calc: entry.data, slug: entry.id },
    }));
}

interface Props {
  calc: CalculatorData;
  slug: CalculatorId;
}

const { calc, slug } = Astro.props as Props;
const relatedCalculators = await getRelatedCalculators(slug);

// Optional short teaching block (intro + how-to + worked example + FAQ) rendered
// below the tool. Source: src/content/calculator-content/{slug}.mdx, draft:false.
type TeachingEntry = CollectionEntry<'calculator-content'>;
const teachingEntries = await getCollection('calculator-content');
const teaching = teachingEntries.find(
  (entry: TeachingEntry) => entry.id.replace(/\.[^.]+$/, '') === slug && !entry.data.draft,
);
let Teaching: Awaited<ReturnType<TeachingEntry['render']>>['Content'] | undefined;
if (teaching) {
  const rendered = await teaching.render();
  Teaching = rendered.Content;
}
// The teaching block carries the page's dates; a tool with no prose yet shows
// the byline alone.
const dates = guideDates(teaching?.data ?? {});

const breadcrumbs: BreadcrumbItem[] = [
  { label: 'Home', route: routes.home() },
  { label: 'Calculators', route: routes.calculatorsHub() },
  { label: calc.title, route: routes.calculator(slug) },
];
const site = Astro.site ?? Astro.url;
const calculatorSchema = webPageSchema(
  {
    id: slug,
    name: calc.title,
    description: calc.description,
    datePublished: dates.published,
    dateModified: dates.reviewed,
  },
  site,
);
const calculatorJsonLd = [
  calculatorSchema,
  webSiteSchema(site),
  organizationSchema(site, { logo: '/apple-touch-icon.png' }),
];
---

<BaseLayout
  title={`${calc.title} | Statohub`}
  description={calc.description}
  canonicalPath={routes.calculator(slug)}
  breadcrumbs={breadcrumbs}
  jsonLd={calculatorJsonLd}
>
  <section class="calc-hero">
    <span class="pill">Calculator</span>
    <h1>{calc.title}</h1>
    <p class="desc">{calc.description}</p>
    <div class="meta-row calc-meta">
      <span class="m"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" /><path d="M4 20a8 8 0 0 1 16 0" /></svg>By <Link to={EDITORIAL_TEAM.route}>{EDITORIAL_TEAM.name}</Link></span>
      {dates.publishedLabel && <span class="m"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /></svg>{dates.publishedLabel}</span>}
      {dates.reviewedLabel && <span class="m"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 20a8 8 0 1 0-8-8" /><path d="M12 8v4l3 2" /></svg>{dates.reviewedLabel}</span>}
    </div>
  </section>

  <StatCalc slug={slug} variant="page" />

  <section class="howto">
    <div class="article-prose calc-teaching">
      {Teaching ? (
        <Teaching />
      ) : (
        <>
          <h2>How to use this calculator</h2>
          <p>Enter the values requested above, then compute the result. The calculator updates from the same pure engine used across Statohub examples.</p>
        </>
      )}
    </div>

    <aside class="side-card" aria-labelledby="related-calculators-heading">
      <h3 id="related-calculators-heading">Related calculators</h3>
      <div class="calc-related-list">
        {
          relatedCalculators.map((item) => (
            <Link class="tool calc-related-card" to={routes.calculator(item.id)}>
              <span class="t-ico" aria-hidden="true">fx</span>
              <span>
                <span class="t-name">{item.title}</span><br />
                <span class="t-sub">{item.description}</span>
              </span>
            </Link>
          ))
        }
      </div>
    </aside>
  </section>
</BaseLayout>