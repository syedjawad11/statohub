---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Callout from '../../../components/applied/Callout.astro';
import Checklist from '../../../components/applied/Checklist.astro';
import DataTable from '../../../components/applied/DataTable.astro';
import FAQ from '../../../components/applied/FAQ.astro';
import Figure from '../../../components/applied/Figure.astro';
import KeyTakeaways from '../../../components/applied/KeyTakeaways.astro';
import Sources from '../../../components/applied/Sources.astro';
import TableOfContents from '../../../components/applied/TableOfContents.astro';
import ComparisonMatrix from '../../../components/applied/infographics/ComparisonMatrix.astro';
import ProcessFlow from '../../../components/applied/infographics/ProcessFlow.astro';
import TaxonomyTree from '../../../components/applied/infographics/TaxonomyTree.astro';

const description = 'Internal preview of the Applied Statistics module components. Not part of the public site and excluded from search indexing.';
---

<BaseLayout
  title="Component preview"
  description={description}
  noindex={true}
  showBreadcrumbs={false}
>
  <div class="preview-page">
    <header class="preview-header">
      <p class="preview-kicker">Internal preview</p>
      <h1>Component preview</h1>
      <p class="preview-note">
        This page is internal and unlisted. It collects Applied Statistics modules for light and dark mode review.
      </p>
    </header>

    <section class="preview-section" aria-labelledby="preview-key-takeaways">
      <div class="preview-section-heading">
        <p>01</p>
        <h2 id="preview-key-takeaways">KeyTakeaways</h2>
      </div>
      <div class="preview-stack">
        <KeyTakeaways
          rows={[
            { point: 'Signal', details: 'A stable metric should move within its expected operating range.' },
            { point: 'Threshold', details: 'Escalate only after the shift persists across two evaluation windows.' },
            { point: 'Response', details: 'Confirm data quality before retraining or changing a production model.' },
          ]}
        />
        <KeyTakeaways
          variant="bullets"
          heading="Before you investigate"
          bullets={[
            'Freeze the reference window used for comparison.',
            'Check whether a pipeline or schema change explains the shift.',
            'Record the decision threshold before reviewing the result.',
          ]}
        />
      </div>
    </section>

    <section class="preview-section" aria-labelledby="preview-callout">
      <div class="preview-section-heading">
        <p>02</p>
        <h2 id="preview-callout">Callout</h2>
      </div>
      <div class="preview-stack">
        <Callout title="Pro tip">
          Compare the same day of the week when seasonality is stronger than the drift signal.
        </Callout>
        <Callout variant="note" title="Interpretation note">
          Statistical significance indicates evidence of a shift, not whether the shift matters operationally.
        </Callout>
        <Callout
          variant="quote"
          source="NIST/SEMATECH e-Handbook of Statistical Methods"
          sourceHref="https://www.itl.nist.gov/div898/handbook/"
        >
          Process monitoring works best when the measurement system is stable and the decision rule is defined in advance.
        </Callout>
      </div>
    </section>

    <section class="preview-section" aria-labelledby="preview-checklist">
      <div class="preview-section-heading">
        <p>03</p>
        <h2 id="preview-checklist">Checklist</h2>
      </div>
      <div class="preview-stack">
        <Checklist
          id="preview-investigation-runbook"
          title="Drift investigation runbook"
          items={[
            'Confirm the alert reproduces on a fixed window.',
            { text: 'Inspect upstream changes', detail: 'Review schema, units, missingness, and category levels.' },
            { text: 'Measure user impact', detail: 'Separate statistically visible movement from operational harm.' },
          ]}
        />
        <Checklist
          title="Release readiness"
          style="check"
          items={[
            'Reference and comparison windows are documented.',
            { text: 'Thresholds are approved', detail: 'Owners know which values warn, fail, and stop the release.' },
            'The rollback path has been tested.',
          ]}
        />
      </div>
    </section>

    <section class="preview-section" aria-labelledby="preview-data-table">
      <div class="preview-section-heading">
        <p>04</p>
        <h2 id="preview-data-table">DataTable</h2>
      </div>
      <div class="preview-stack">
        <DataTable
          caption="Production signal review"
          headers={['Signal', 'Status', 'Owner', 'Score']}
          rows={[
            ['Schema contract', 'Pass', 'Data platform', 98],
            ['Feature drift', 'Warning', 'Model team', 73],
            ['Missing values', 'Fail', 'Analytics', 41],
            ['Prediction stability', 'Severe', 'ML operations', 18],
            ['Segment coverage', 'Monitor', 'Research', 67],
          ]}
          align={['left', 'center', 'left', 'right']}
          badgeColumns={[1]}
        />

        <DataTable
          caption="Evaluation windows"
          headers={['Window', 'Mean error', 'Action']}
          align={['left', 'right', 'left']}
        >
          <tr>
            <td>Previous 7 days</td>
            <td class="data-align-right">0.18</td>
            <td>Continue monitoring</td>
          </tr>
          <tr>
            <td>Previous 30 days</td>
            <td class="data-align-right">0.24</td>
            <td>Review affected segments</td>
          </tr>
        </DataTable>
      </div>
    </section>

    <section class="preview-section" aria-labelledby="preview-sources">
      <div class="preview-section-heading">
        <p>05</p>
        <h2 id="preview-sources">Sources</h2>
      </div>
      <div class="preview-stack">
        <Sources
          heading="References used in this analysis"
          items={[
            {
              text: 'NIST/SEMATECH e-Handbook of Statistical Methods',
              href: 'https://www.itl.nist.gov/div898/handbook/',
              org: 'National Institute of Standards and Technology',
            },
            {
              text: 'Trustworthy Online Controlled Experiments',
              href: 'https://www.cambridge.org/core/books/trustworthy-online-controlled-experiments/D97B26382EB0EB2DC2019A7A710C845A',
              org: 'Cambridge University Press',
            },
          ]}
        />
      </div>
    </section>

    <section class="preview-section" aria-labelledby="preview-faq">
      <div class="preview-section-heading">
        <p>06</p>
        <h2 id="preview-faq">FAQ</h2>
      </div>
      <div class="preview-stack">
        <FAQ
          items={[
            {
              question: 'What is model drift?',
              answer: 'Model drift is a measurable change in the data, relationships, or outcomes that a model encounters after deployment.',
            },
            {
              question: 'How often should drift be checked?',
              answer: 'Check often enough to match the decision cycle and the speed at which the underlying process can change.',
            },
            {
              question: 'Does a statistically significant shift require retraining?',
              answer: 'No. First confirm data quality and practical impact, then retrain only when the evidence supports an operational change.',
            },
          ]}
        />
      </div>
    </section>

    <section class="preview-section" aria-labelledby="preview-figure">
      <div class="preview-section-heading">
        <p>07</p>
        <h2 id="preview-figure">Figure</h2>
      </div>
      <div class="preview-stack">
        <Figure
          id="preview-monitoring-cycle"
          number={1}
          caption="Reserved space showing how a future monitoring-cycle infographic will sit inside the caption wrapper."
        >
          <div class="preview-figure-placeholder">
            Future infographic slot
          </div>
        </Figure>
        <Figure caption="An unnumbered caption renders without an automatic prefix.">
          <div class="preview-figure-placeholder">
            Presentation-only child content
          </div>
        </Figure>
      </div>
    </section>

    <section class="preview-section" aria-labelledby="preview-table-of-contents">
      <div class="preview-section-heading">
        <p>08</p>
        <h2 id="preview-table-of-contents">TableOfContents</h2>
      </div>
      <div class="preview-stack">
        <TableOfContents
          items={[
            { text: 'Key takeaways', href: '#preview-key-takeaways' },
            { text: 'Callout variants', href: '#preview-callout', depth: 3 },
            { text: 'Operational checklist', href: '#preview-checklist', depth: 2 },
            { text: 'Evaluation tables', href: '#preview-data-table', depth: 3 },
            { text: 'Frequently asked questions', href: '#preview-faq', depth: 2 },
          ]}
        />
      </div>
    </section>

    <section class="preview-section" aria-labelledby="preview-process-flow">
      <div class="preview-section-heading">
        <p>09</p>
        <h2 id="preview-process-flow">ProcessFlow</h2>
      </div>
      <div class="preview-stack">
        <Figure number={2} caption="A horizontal drift-detection pipeline from monitoring through response.">
          <ProcessFlow
            title="Drift-detection pipeline"
            desc="Four connected steps move from collecting production data to measuring drift, reviewing impact, and choosing a response."
            steps={[
              { label: 'Collect data', detail: 'Freeze the reference and comparison windows.' },
              { label: 'Measure drift', detail: 'Calculate the agreed feature-level statistics.' },
              { label: 'Review impact', detail: 'Check affected segments and decision outcomes.' },
              { label: 'Choose response', detail: 'Monitor, repair data, or retrain the model.' },
            ]}
          />
        </Figure>

        <Figure number={3} caption="The same process rendered vertically for a narrow editorial layout.">
          <ProcessFlow
            title="Vertical incident review"
            desc="Three connected vertical steps show how an alert is validated, investigated, and resolved."
            direction="vertical"
            steps={[
              { label: 'Validate alert', detail: 'Reproduce the signal on a fixed evaluation window.' },
              { label: 'Investigate cause', detail: 'Inspect schema changes, missingness, and segment movement.' },
              { label: 'Record decision', detail: 'Document the owner, action, and next review date.' },
            ]}
          />
        </Figure>
      </div>
    </section>

    <section class="preview-section" aria-labelledby="preview-taxonomy-tree">
      <div class="preview-section-heading">
        <p>10</p>
        <h2 id="preview-taxonomy-tree">TaxonomyTree</h2>
      </div>
      <div class="preview-stack">
        <Figure number={4} caption="A monitoring taxonomy that separates data, prediction, and outcome signals.">
          <TaxonomyTree
            title="Production monitoring taxonomy"
            desc="Production monitoring divides into data quality, prediction behaviour, and outcome performance, with example signals under each branch."
            root="Production monitoring"
            branches={[
              { label: 'Data quality', children: ['Schema validity', 'Missing values'] },
              { label: 'Prediction behaviour', children: ['Score drift', 'Segment coverage'] },
              { label: 'Outcome performance', children: ['Calibration', 'Error rate'] },
            ]}
          />
        </Figure>
      </div>
    </section>

    <section class="preview-section" aria-labelledby="preview-comparison-matrix">
      <div class="preview-section-heading">
        <p>11</p>
        <h2 id="preview-comparison-matrix">ComparisonMatrix</h2>
      </div>
      <div class="preview-stack">
        <Figure number={5} caption="Monitoring methods scored from 0 to 100, with every intensity-coded cell retaining its numeric value.">
          <ComparisonMatrix
            title="Monitoring method comparison"
            desc="A matrix compares three monitoring methods on sensitivity, interpretability, and implementation effort using numeric scores from zero to one hundred."
            columns={['PSI', 'KS test', 'Classifier']}
            rows={[
              { label: 'Sensitivity', values: [72, 88, 94] },
              { label: 'Interpretability', values: [91, 76, 58] },
              { label: 'Low implementation effort', values: [86, 79, 43] },
            ]}
            scaleMax={100}
          />
        </Figure>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .preview-page {
    width: min(100%, 860px);
    margin-inline: auto;
    padding-block: 3.5rem 5rem;
    color: var(--ink);
  }

  .preview-header {
    padding-bottom: 2.25rem;
    border-bottom: 1px solid var(--line-2);
  }

  .preview-kicker,
  .preview-section-heading p {
    margin: 0 0 0.45rem;
    color: var(--clay);
    font-family: var(--mono);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .preview-header h1 {
    margin: 0;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(2.35rem, 7vw, 4.4rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 0.98;
  }

  .preview-note {
    max-width: 42rem;
    margin: 1rem 0 0;
    color: var(--ink-2);
  }

  .preview-section {
    padding-block: 2.75rem;
    border-bottom: 1px solid var(--line);
  }

  .preview-section-heading {
    margin-bottom: 1.25rem;
  }

  .preview-section-heading h2 {
    margin: 0;
    color: var(--ink);
    font-family: var(--serif);
    font-size: 1.85rem;
    font-weight: 500;
    line-height: 1.1;
  }

  .preview-stack {
    display: grid;
    gap: 1.25rem;
  }

  .preview-figure-placeholder {
    display: grid;
    min-height: 10rem;
    place-items: center;
    padding: 1.5rem;
    background: var(--pine-soft);
    color: var(--pine);
    font-family: var(--mono);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-align: center;
    text-transform: uppercase;
  }

  @media (max-width: 640px) {
    .preview-page {
      padding-block: 2.5rem 4rem;
    }

    .preview-section {
      padding-block: 2.2rem;
    }
  }
</style>
