---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Link from '../components/Link.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  routes,
  type CalculatorId,
  type CategoryId,
  type RouteRef,
} from '../lib/links';
import { organizationSchema, webSiteSchema } from '../lib/schema';

type CategoryEntry = CollectionEntry<'categories'>;
type ArticleEntry = CollectionEntry<'articles'>;
type CalculatorEntry = CollectionEntry<'calculators'>;

const site = Astro.site ?? Astro.url;
const homeJsonLd = [
  webSiteSchema(site),
  organizationSchema(site, { logo: '/apple-touch-icon.png' }),
];

const categories: CategoryEntry[] = await getCollection('categories');
const publishedGuides: ArticleEntry[] = (await getCollection('articles')).filter(
  (entry: ArticleEntry) => !entry.data.draft,
);
const standaloneCalculators: CalculatorEntry[] = (await getCollection('calculators')).filter(
  (entry: CalculatorEntry) => entry.data.standalone !== false,
);

const categoryId = (entry: CategoryEntry) => entry.id.replace(/\.[^.]+$/, '') as CategoryId;
const categoryById = new Map<CategoryId, CategoryEntry>(
  categories.map((entry: CategoryEntry) => [categoryId(entry), entry]),
);

const getCategory = (id: CategoryId) => {
  const entry = categoryById.get(id);
  if (!entry) throw new Error(`Homepage category is missing: ${id}`);
  return entry;
};

const guideCount = (id: CategoryId) => publishedGuides.filter(
  (entry: ArticleEntry) => entry.data.category.id === id,
).length;
const calculatorCount = (id: CategoryId) => standaloneCalculators.filter(
  (entry: CalculatorEntry) => entry.data.category?.id === id,
).length;

const learnCategoryIds = [
  'foundations',
  'descriptive-statistics',
  'probability-distributions',
  'regression-correlation',
  'inferential-statistics',
] satisfies CategoryId[];

const learnTopics = learnCategoryIds.map((id, index) => ({
  id,
  entry: getCategory(id),
  number: String(index + 1).padStart(2, '0'),
  guides: guideCount(id),
  calculators: calculatorCount(id),
}));

const appliedCategoryIds = [
  'data-analysis',
  'experiments-causality',
  'time-series-forecasting',
  'machine-learning-statistics',
] satisfies CategoryId[];

const appliedTopics = appliedCategoryIds.map((id, index) => ({
  id,
  entry: getCategory(id),
  number: String(index + 1).padStart(2, '0'),
  guides: guideCount(id),
}));

const learnCategorySet = new Set(
  categories
    .filter((entry: CategoryEntry) => entry.data.section === 'learn')
    .map((entry: CategoryEntry) => categoryId(entry)),
);
const learnGuideCount = publishedGuides.filter((entry: ArticleEntry) => (
  learnCategorySet.has(entry.data.category.id as CategoryId)
)).length;

const popularCalculatorIds = [
  'mean',
  'standard-deviation',
  'z-score',
  'confidence-interval',
  'linear-regression',
  'sample-size',
  'frequency-table',
  'probability',
] satisfies CalculatorId[];
const calculatorById = new Map<CalculatorId, CalculatorEntry>(
  standaloneCalculators.map((entry: CalculatorEntry) => [entry.id as CalculatorId, entry]),
);
const popularCalculators = popularCalculatorIds.map((id) => {
  const entry = calculatorById.get(id);
  if (!entry) throw new Error(`Homepage calculator is missing or not standalone: ${id}`);
  return { id, entry };
});

const pathways = [
  {
    label: 'Learn',
    routerTitle: 'Learn a concept',
    description: 'Build understanding with clear, connected lessons.',
    meta: `${learnGuideCount} published guides`,
    route: routes.learnLanding(),
    tone: 'learn',
  },
  {
    label: 'Calculate',
    routerTitle: 'Run a calculation',
    description: 'Use focused tools that keep the method close by.',
    meta: `${standaloneCalculators.length} standalone tools`,
    route: routes.calculatorsHub(),
    tone: 'calculate',
  },
  {
    label: 'Apply',
    routerTitle: 'Solve a real problem',
    description: 'Move from statistical ideas to practical decisions.',
    meta: `${appliedTopics.length} practical topic hubs`,
    route: routes.appliedLanding(),
    tone: 'apply',
  },
] satisfies Array<{
  label: string;
  routerTitle: string;
  description: string;
  meta: string;
  route: RouteRef;
  tone: 'learn' | 'calculate' | 'apply';
}>;
---

<BaseLayout
  title="Statohub - Learn, Calculate, and Apply Statistics"
  description="Learn statistics through clear guides, run focused calculators, and explore practical data analysis, experimentation, forecasting, and machine learning topics."
  canonicalPath={routes.home()}
  jsonLd={homeJsonLd}
>
  <section class="home3-hero" aria-labelledby="home3-title">
    <div class="home3-hero-copy">
      <p class="home3-kicker">Statistics, made usable</p>
      <h1 id="home3-title">Learn statistics.<br /><em>Use</em> it with confidence.</h1>
      <p class="home3-lede">
        Clear lessons, reliable calculators, and practical guides that help you understand the method, check the numbers, and make a defensible decision.
      </p>
      <div class="home3-hero-actions">
        <Link to={routes.learnLanding()} class="btn btn-pine">Start learning</Link>
        <Link to={routes.calculatorsHub()} class="btn btn-ghost">Open calculators</Link>
      </div>
      <p class="home3-proof">
        <span>{learnGuideCount} published guides</span>
        <span aria-hidden="true">·</span>
        <span>{standaloneCalculators.length} calculators</span>
        <span aria-hidden="true">·</span>
        <span>{appliedTopics.length} applied hubs</span>
      </p>
    </div>

    <aside class="home3-router" aria-labelledby="home3-router-title">
      <div class="home3-router-head">
        <p>Choose your route</p>
        <h2 id="home3-router-title">What do you need today?</h2>
      </div>
      <div class="home3-router-list">
        {pathways.map((path, index) => (
          <Link class={`home3-router-link is-${path.tone}`} to={path.route}>
            <span class="home3-router-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <span>
              <strong>{path.routerTitle}</strong>
              <small>{path.description}</small>
            </span>
            <span class="home3-arrow" aria-hidden="true">→</span>
          </Link>
        ))}
      </div>
    </aside>
  </section>

  <section class="home3-pathways" aria-labelledby="home3-pathways-title">
    <h2 id="home3-pathways-title" class="sr-only">Learn, calculate, and apply</h2>
    {pathways.map((path) => (
      <Link class={`home3-pathway is-${path.tone}`} to={path.route}>
        <span class="home3-pathway-label">{path.label}</span>
        <h3>{path.routerTitle}</h3>
        <p>{path.description}</p>
        <span class="home3-pathway-meta">{path.meta} <span aria-hidden="true">→</span></span>
      </Link>
    ))}
  </section>

  <section class="home3-section" aria-labelledby="home3-learn-title">
    <header class="home3-section-head">
      <div>
        <p class="home3-kicker">Learn by topic</p>
        <h2 id="home3-learn-title">Build a strong statistical foundation</h2>
        <p>Start with the idea you need, then follow the connected guides and tools at your own pace.</p>
      </div>
      <Link to={routes.learnLanding()} class="home3-section-link">Explore all Learn topics <span aria-hidden="true">→</span></Link>
    </header>

    <div class="home3-topic-grid">
      {learnTopics.map((topic) => (
        <Link class="home3-topic-card" to={routes.categoryHub(topic.id)}>
          <span class="home3-card-number" aria-hidden="true">{topic.number}</span>
          <h3>{topic.entry.data.title}</h3>
          <p>{topic.entry.data.description}</p>
          <span class="home3-card-meta">
            <span><b>{topic.guides}</b> guides</span>
            <span><b>{topic.calculators}</b> tools</span>
          </span>
        </Link>
      ))}
    </div>
  </section>

  <section class="home3-section home3-applied" aria-labelledby="home3-applied-title" data-applied-section>
    <header class="home3-section-head">
      <div>
        <p class="home3-kicker">Applied statistics</p>
        <h2 id="home3-applied-title">Use statistics where decisions get made</h2>
        <p>Explore practical topic hubs now; in-depth Applied guides will appear here as they are published.</p>
      </div>
      <Link to={routes.appliedLanding()} class="home3-section-link">Browse Applied Statistics <span aria-hidden="true">→</span></Link>
    </header>

    <div class="home3-filters" role="group" aria-label="Filter Applied Statistics topics">
      <button type="button" class="home3-filter" data-applied-filter="all" aria-pressed="true">All topics</button>
      {appliedTopics.map((topic) => (
        <button type="button" class="home3-filter" data-applied-filter={topic.id} aria-pressed="false">
          {topic.entry.data.title}
        </button>
      ))}
    </div>
    <p class="sr-only" aria-live="polite" data-applied-filter-status>
      Showing all {appliedTopics.length} Applied Statistics topics.
    </p>

    <div class="home3-applied-grid" id="home3-applied-grid">
      {appliedTopics.map((topic) => (
        <article class="home3-applied-card" data-applied-card={topic.id}>
          <div class="home3-applied-card-top">
            <span class="home3-card-number" aria-hidden="true">A{topic.number}</span>
            <span class="home3-coming-soon">{topic.guides} published guides</span>
          </div>
          <h3><Link to={routes.categoryHub(topic.id)}>{topic.entry.data.title}</Link></h3>
          <p>{topic.entry.data.description}</p>
          <Link class="home3-card-link" to={routes.categoryHub(topic.id)}>
            Visit the topic hub <span aria-hidden="true">→</span>
          </Link>
        </article>
      ))}
    </div>
  </section>

  <section class="home3-section home3-tools" aria-labelledby="home3-tools-title">
    <header class="home3-section-head">
      <div>
        <p class="home3-kicker">Popular calculators</p>
        <h2 id="home3-tools-title">Run the numbers, then understand them</h2>
        <p>Each focused calculator is free to use and paired with enough context to make the result meaningful.</p>
      </div>
      <Link to={routes.calculatorsHub()} class="home3-section-link">See all {standaloneCalculators.length} calculators <span aria-hidden="true">→</span></Link>
    </header>

    <ol class="home3-tool-list">
      {popularCalculators.map((tool, index) => (
        <li>
          <Link class="home3-tool-link" to={routes.calculator(tool.id)}>
            <span class="home3-tool-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <span class="home3-tool-copy">
              <strong>{tool.entry.data.title}</strong>
              <small>{tool.entry.data.description}</small>
            </span>
            <span class="home3-arrow" aria-hidden="true">→</span>
          </Link>
        </li>
      ))}
    </ol>
  </section>

  <script is:inline>
    (() => {
      const section = document.querySelector('[data-applied-section]');
      if (!section) return;

      section.classList.add('filters-active');
      const buttons = section.querySelectorAll('[data-applied-filter]');
      const cards = section.querySelectorAll('[data-applied-card]');
      const status = section.querySelector('[data-applied-filter-status]');

      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          const filter = button.getAttribute('data-applied-filter') ?? 'all';
          const label = button.textContent?.trim() ?? 'all topics';
          let visibleCount = 0;

          buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
          cards.forEach((card) => {
            const visible = filter === 'all' || card.getAttribute('data-applied-card') === filter;
            card.toggleAttribute('hidden', !visible);
            if (visible) visibleCount += 1;
          });

          if (status) {
            status.textContent = filter === 'all'
              ? `Showing all ${visibleCount} Applied Statistics topics.`
              : `Showing ${visibleCount} topic: ${label}.`;
          }
        });
      });
    })();
  </script>
</BaseLayout>
